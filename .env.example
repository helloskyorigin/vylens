# Copy key/value names into Vercel Project → Settings → Environment Variables.
# NEVER commit a real API key or expose it in client-side JavaScript.
GROQ_API_KEY=
# Default Groq model with strict JSON Schema support
GROQ_MODEL=openai/gpt-oss-120b
# No API key means only deterministic local/browser audit findings are returned.
# Product file excerpts are forwarded only after explicit checkbox consent.
